{
  "compilerOptions": {
    "strict": true,
  "noImplicitAny": false,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "paths": {
      "@/*": ["./frontend/src/*"]
    },
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["frontend/src"]
}
